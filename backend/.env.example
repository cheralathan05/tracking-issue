PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartgov_auth?schema=public
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_second_long_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_ORIGIN=http://localhost:5173
AUTH_ACCESS_COOKIE_NAME=smartgov_access
AUTH_REFRESH_COOKIE_NAME=smartgov_refresh
OTP_EXPIRY_MINUTES=10
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="SmartGov <no-reply@smartgov.gov>"
EMAIL_USER=smartgov.admin@gmail.com
EMAIL_PASS=google_app_password

# Official accounts used for admin/officer testing
ADMIN_ALLOWED_EMAILS=smartgov.admin@gmail.com,tn.state.admin@gmail.com,smartgov.helpdesk@gmail.com

# Government Email Domain Validation
# Comma-separated list of allowed email domains for admin registration
# Only admins must use government email addresses
# Citizens can register with any email (gmail, yahoo, etc.)
ALLOWED_ADMIN_DOMAINS=smartgov.in,gov.in,nic.in