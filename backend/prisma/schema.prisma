generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  super_admin
  state_admin
  district_officer
  department_officer
  citizen
  admin
  officer
}

enum OtpPurpose {
  registration
  password_reset
  admin_login
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  username    String?  @unique
  email       String   @unique
  mobile      String   @unique
  aadhaar     String   @unique
  state       String
  district    String
  address     String
  department  String?
  jurisdictionArea String?
  officerCode String?  @unique
  password    String
  role        Role     @default(citizen)
  isVerified  Boolean  @default(false)
  emailVerified Boolean @default(false)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]
  reporterComplaints Complaint[] @relation("ComplaintReporter")
  assignedComplaints Complaint[] @relation("ComplaintAssignedOfficer")
  invitationsCreated OfficerInvitation[] @relation("InvitationCreator")
  invitationsAccepted OfficerInvitation[] @relation("InvitationAcceptedBy")
  chatParticipants ChatParticipant[]
  sentMessages ChatMessage[] @relation("ChatMessageSender")
  receivedMessages ChatMessage[] @relation("ChatMessageReceiver")
  uploadedAttachments ChatAttachment[]
  chatNotifications ChatNotification[]
  notifications Notification[]
  complaintTimelines ComplaintTimeline[]
  escalationsCreated Escalation[] @relation("EscalationCreator")
  escalationsResolved Escalation[] @relation("EscalationResolver")
  feedbackSubmitted Feedback[]
  complaintAttachments ComplaintAttachment[]
  aiInsightsCreated AIInsight[]
  satisfactionFeedbackSubmitted SatisfactionFeedback[]

  @@map("users")
}

model Complaint {
  id                  String   @id @default(cuid())
  grievanceId         String   @unique
  reporterUserId      String?
  reporterName        String
  reporterEmail       String?
  reporterMobile      String?
  title               String
  category            String
  department          String
  description         String
  state               String
  district            String
  city                String
  address             String
  landmark            String?
  pincode             String
  priority            String
  status              String   @default("Submitted")
  publicVisibility    Boolean  @default(true)
  suggestedOfficerId  String?
  suggestedOfficerName String?
  assignedOfficerId   String?
  assignedOfficerName String?
  assignedDepartment  String?
  assignedArea        String?
  evidence            Json?
  timeline            Json?
  resolutionSummary   String?
  resolutionEvidence  Json?
  latitude            Float?
  longitude           Float?
  slaDeadline         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reporterUser User? @relation("ComplaintReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  assignedOfficer User? @relation("ComplaintAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  chatRooms ChatRoom[]
  chatMessages ChatMessage[]
  timelines ComplaintTimeline[]
  escalation Escalation?
  feedback Feedback?
  attachments ComplaintAttachment[]
  aiInsights AIInsight[]
  satisfactionFeedback SatisfactionFeedback?

  @@index([status])
  @@index([department])
  @@index([district])
  @@index([assignedOfficerId])
  @@map("complaints")
}

model OfficerInvitation {
  id           String   @id @default(cuid())
  code         String   @unique
  fullName     String
  email        String   @unique
  mobile       String
  username     String?  @unique
  department   String
  area         String
  role         Role     @default(officer)
  status       String   @default("Pending")
  invitedById  String?
  acceptedById String?   @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitedBy User? @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([department])
  @@map("officer_invitations")
}

model RefreshToken {
  id          String   @id @default(cuid())
  jti         String   @unique
  tokenHash   String
  userId      String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   OtpPurpose @default(password_reset)
  expiresAt DateTime
  verified  Boolean  @default(false)
  verifiedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([email, purpose])
  @@map("otps")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// Chat support models
model ChatRoom {
  id          String   @id @default(cuid())
  complaintId String?
  roomType    String   @default("complaint")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaint   Complaint?        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages    ChatMessage[]
  notifications ChatNotification[]

  @@index([complaintId])
  @@map("chat_rooms")
}

model ChatParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      Role
  joinedAt  DateTime @default(now())
  lastSeenAt DateTime?
  isMuted   Boolean  @default(false)

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id          String   @id @default(cuid())
  roomId      String
  senderId    String
  receiverId  String?
  complaintId String?
  message     String?
  messageType String   @default("text")
  attachment  Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("ChatMessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  attachments ChatAttachment[]
  notifications ChatNotification[]

  @@index([roomId])
  @@index([senderId])
  @@index([receiverId])
  @@index([complaintId])
  @@map("chat_messages")
}

model ChatAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileUrl    String
  fileType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User       @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("chat_attachments")
}

model ChatNotification {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  messageId String?
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomId])
  @@map("chat_notifications")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  priority  String   @default("medium")
  isRead    Boolean  @default(false)
  actionUrl String?
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// Complaint timeline tracking
model ComplaintTimeline {
  id          String   @id @default(cuid())
  complaintId String
  oldStatus   String?
  newStatus   String
  changedBy   String?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([createdAt])
  @@map("complaint_timelines")
}

// Escalation tracking
model Escalation {
  id          String   @id @default(cuid())
  complaintId String   @unique
  escalatedBy String
  reason      String
  level       String   @default("low") // low, medium, high, emergency
  status      String   @default("active") // active, resolved, closed
  resolvedBy  String?
  resolutionNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  escalatedByUser User @relation("EscalationCreator", fields: [escalatedBy], references: [id], onDelete: Cascade)
  resolvedByUser User? @relation("EscalationResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([level])
  @@index([createdAt])
  @@map("escalations")
}

// Feedback and ratings
model Feedback {
  id          String   @id @default(cuid())
  complaintId String   @unique
  rating      Int      // 1-5 stars
  comment     String?
  officerRating Int?   // 1-5 stars for officer
  overallSatisfaction Boolean @default(true)
  suggestedImprovements String?
  submittedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  submittedByUser User @relation(fields: [submittedBy], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([createdAt])
  @@map("feedback")
}

model ComplaintAttachment {
  id          String   @id @default(cuid())
  complaintId String
  uploadedBy  String
  fileUrl     String
  fileType    String
  fileName    String?
  fileSize    Int?
  previewUrl  String?
  downloadCount Int   @default(0)
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([uploadedBy])
  @@map("complaint_attachments")
}

model AIInsight {
  id            String   @id @default(cuid())
  complaintId   String
  createdBy     String?
  source        String   @default("ollama")
  model         String
  summary       String
  urgency       String
  department    String
  escalationRisk String
  sentiment     String
  priority      String
  confidence    Float    @default(0.7)
  payload       Json?
  createdAt     DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  creator   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([createdBy])
  @@map("ai_insights")
}

model SatisfactionFeedback {
  id                    String   @id @default(cuid())
  complaintId           String   @unique
  rating                Int
  comment               String?
  officerRating         Int?
  overallSatisfaction   Boolean  @default(true)
  suggestedImprovements String?
  submittedBy           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  submittedByUser User    @relation(fields: [submittedBy], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([createdAt])
  @@map("satisfaction_feedback")
}