# Frontend Environment Variables (Production & Development)
PORT=5173

# Optional: Set to backend Render URL if calling API directly from browser
# If using the built-in frontend reverse proxy, leave as /api
VITE_API_BASE_URL=/api

# Optional: Set if socket connects directly to external domain
# VITE_SOCKET_URL=https://civic-bridge-backend.onrender.com

# Backend URL used by frontend server reverse proxy in production
# BACKEND_URL=https://civic-bridge-backend.onrender.com
